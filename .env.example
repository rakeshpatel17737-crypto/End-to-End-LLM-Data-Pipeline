POSTGRES_USER=llmplatform
POSTGRES_PASSWORD=llmplatform
POSTGRES_DB=llm_platform
AIRFLOW_DB=airflow

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme_generate_with_fernet

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=changeme_random_32_char_hex

# Groq API key (free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings run locally via sentence-transformers (all-MiniLM-L6-v2) — no key needed.

LOG_LEVEL=INFO
ENVIRONMENT=development
DAILY_COST_BUDGET_USD=10.0
