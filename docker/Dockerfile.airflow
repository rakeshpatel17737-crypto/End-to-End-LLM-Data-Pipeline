FROM apache/airflow:2.9.2-python3.11

USER airflow

# CPU-only PyTorch first (avoids pulling the multi-GB NVIDIA CUDA stack),
# then the rest of the pipeline dependencies.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir \
      groq \
      sentence-transformers \
      pydantic-settings \
      pgvector \
      psycopg2-binary \
      pymupdf \
      langdetect \
      datasketch \
      tenacity \
      structlog \
      duckdb \
      httpx \
      beautifulsoup4 \
      tiktoken \
      numpy \
      pandas
